                'index.html': `<!DOCTYPE html><html><head><title>${window.currentTask.projectName}</title></head><body><h1>${window.currentTask.projectName}</h1><p>A cool app all about the topic!</p></body></html>`,
                'styles.css': 'body { font-family: Arial, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px; }',
                'script.js': `console.log("${window.currentTask.projectName} loaded");`,
                'README.md': `# ${window.currentTask.projectName}\n\nGenerated by CrackerBot AI.`
            };
        }
        
        window.currentTask.status = 'Complete';
        window.currentTask.completed = true;
        window.currentTask.completedAt = new Date().toISOString();
        
        // Save to storage
        const projects = JSON.parse(localStorage.getItem('crackerBotProjects') || '[]');
        projects.push({...window.currentTask});
        localStorage.setItem('crackerBotProjects', JSON.stringify(projects));
        
        // Hide progress UI
        setTimeout(() => {
            const taskSection = document.getElementById('task-status-section');
            if (taskSection) taskSection.style.display = 'none';
            const progressContainer = document.querySelector('.progress-container');
            if (progressContainer) progressContainer.style.display = 'none';
        }, 1000);
        
        // Show completion message
        if (window.addMessage) {
            window.addMessage('CrackerBot', 
                `✅ "${window.currentTask.projectName}" is complete! ${Object.keys(window.currentTask.files).length} files generated.`, 
                'bot'
            );
        }
        
        // TRY TO OPEN LIVE PREVIEW
        console.log("🎯 [OVERRIDE] Attempting to open live preview...");
        
        setTimeout(() => {
            if (window.livePreview && typeof window.livePreview.autoOpen === 'function') {
                console.log("✅ [OVERRIDE] Opening live preview!");
                try {
                    window.livePreview.autoOpen({
                        taskId: Date.now(),
                        projectName: window.currentTask.projectName || 'Generated Project',
                        projectType: window.currentTask.projectType || 'web-app',
                        features: window.currentTask.features || 'AI Generated Features',
                        frontendId: 'debug-auto-open'
                    });
                } catch (error) {
                    console.error("❌ [OVERRIDE] Live preview failed:", error);
                    // Fallback to post-build options
                    if (window.showPostBuildOptions) {
                        window.showPostBuildOptions();
                    }
                }
            } else {
                console.error("❌ [OVERRIDE] Live preview not available!");
                console.log("Available methods:", Object.keys(window.livePreview || {}));
                // Fallback to post-build options
                if (window.showPostBuildOptions) {
                    window.showPostBuildOptions();
                }
            }
        }, 2000);
    };
    
    // FORCE FIX PREVIEW BUTTON
    window.openProjectPreview = function() {
        console.log("🔧 [OVERRIDE] openProjectPreview called!");
        
        if (window.livePreview && window.livePreview.autoOpen) {
            console.log("🎯 [OVERRIDE] Using livePreview.autoOpen for button...");
            window.livePreview.autoOpen({
                taskId: Date.now(),
                projectName: window.currentTask?.projectName || 'Current Project',
                projectType: window.currentTask?.projectType || 'web-app',
                features: window.currentTask?.features || 'Project features',
                frontendId: 'button-preview'
            });
        } else {
            console.error("❌ [OVERRIDE] Live preview not available for button!");
            alert("Live preview system not loaded yet. Please try again in a moment.");
        }
    };
    
    // ALSO OVERRIDE OTHER PREVIEW FUNCTIONS
    window.showPreviewWithAI = function(task) {
        console.log("🔧 [OVERRIDE] showPreviewWithAI called!");
        window.openProjectPreview();
    };
    
    window.editWithAI = function() {
        console.log("🔧 [OVERRIDE] editWithAI called!");
        window.openProjectPreview();
    };
    
    console.log("✅ All overrides applied!");
    
}, 8000); // Wait 8 seconds for everything to load

console.log("=== DEBUG SCRIPT READY ===");
</script>
