// Preview Popup System with AI Integration

class PreviewPopup {
    constructor(projectData, socket) {
        this.projectData = projectData;
        this.socket = socket;
        this.files = [];
        this.currentFile = null;
        this.viewMode = "preview";
        this.aiThinking = false;
        this.buildProgress = 0;
        
        this.init();
    }
    
    init() {
        this.createModal();
        this.loadFiles();
        this.setupEventListeners();
        this.setupAIIntegration();
    }
    
    createModal() {
        const existing = document.getElementById("preview-popup");
        if (existing) existing.remove();
        
        const modal = document.createElement("div");
        modal.id = "preview-popup";
        modal.className = "preview-overlay";
        
        modal.innerHTML = `
            <div class="preview-modal">
                <div class="preview-header">
                    <div class="preview-title">
                        🚀 Preview: <span class="project-name">${this.projectData.projectName}</span>
                    </div>
                    <div class="preview-actions">
                        <button class="preview-btn download" onclick="previewPopup.download()">
                            📥 Download
                        </button>
                        <button class="preview-btn refine" onclick="previewPopup.refine()">
                            ✨ Refine
                        </button>
                        <button class="preview-btn close" onclick="previewPopup.close()">
                            ✕
                        </button>
                    </div>
                </div>
                
                <div class="preview-body">
                    <div class="preview-sidebar">
                        <div class="file-tabs" id="file-tabs"></div>
                    </div>
                    
                    <div class="preview-content">
                        <div class="view-toggle">
                            <button class="toggle-btn active" onclick="previewPopup.setViewMode('preview')">
                                👁️ Preview
                            </button>
                            <button class="toggle-btn" onclick="previewPopup.setViewMode('code')">
                                </> Code
                            </button>
                        </div>
                        
                        <div id="preview-view" class="preview-iframe-container">
                            <div class="loading-spinner"></div>
                            <iframe class="preview-iframe" id="preview-iframe"></iframe>
                        </div>
                        
                        <div id="code-view" class="code-editor-container" style="display: none;">
                            <div class="code-editor">
                                <textarea id="code-editor" spellcheck="false"></textarea>
                            </div>
                        </div>
                        
                        <div class="ai-panel">
                            <div class="ai-header">
                                <div class="ai-title">🤖 AI Assistant</div>
                                <div class="ai-status" id="ai-status">Ready</div>
                            </div>
                            
                            <div class="ai-input-container">
                                <input type="text" class="ai-input" id="ai-input" 
                                    placeholder="Tell AI what to change..."
                                    onkeypress="if(event.key==='Enter') previewPopup.sendAIRequest()">
                                <button class="ai-send-btn" onclick="previewPopup.sendAIRequest()">
                                    �� Apply
                                </button>
                            </div>
                            
                            <div class="ai-suggestions" id="ai-suggestions">
                                <div onclick="previewPopup.applyAISuggestion('dark mode')">🌙 Add dark mode</div>
                                <div onclick="previewPopup.applyAISuggestion('animations')">✨ Add animations</div>
                                <div onclick="previewPopup.applyAISuggestion('responsive')">📱 Make responsive</div>
                            </div>
                        </div>
                        
                        <div class="build-progress" id="build-progress" style="display: none;">
                            <div class="build-progress-bar" id="build-progress-bar" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        document.body.appendChild(modal);
        window.previewPopup = this;
    }
    
    async loadFiles() {
        this.files = await this.generateProjectFiles();
        this.renderFileTabs();
        
        if (this.files.length > 0) {
            this.selectFile(this.files[0]);
        }
    }
    
    async generateProjectFiles() {
        const files = [];
        
        files.push({
            name: "index.html",
            type: "html",
            content: this.generateHTML(),
            icon: "📄"
        });
        
        files.push({
            name: "styles.css",
            type: "css",
            content: this.generateCSS(),
            icon: "🎨"
        });
        
        files.push({
            name: "app.js",
            type: "javascript",
            content: this.generateJS(),
            icon: "⚡"
        });
        
        files.push({
            name: "README.md",
            type: "markdown",
            content: this.generateREADME(),
            icon: "📖"
        });
        
        return files;
    }
    
    generateHTML() {
        const projectName = this.projectData.projectName || "My Project";
        const features = this.projectData.features || "Amazing features";
        const projectType = this.projectData.projectType || "web-app";
        
        let htmlContent = `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${projectName}</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="cosmic-bg"></div>
    <div class="container">
        <header>
            <h1>🌌 ${projectName}</h1>
            <nav>
                <a href="#home">Home</a>
                <a href="#features">Features</a>
                <a href="#about">About</a>
            </nav>
        </header>
        
        <main>
            <section id="hero">
                <h2>Welcome to ${projectName}</h2>
                <p class="description">${features}</p>
                <button class="cta-button">Get Started</button>
            </section>
            
            <section id="features">
                <h2>Features</h2>
                <div class="feature-grid">
                    <div class="feature-card">
                        <span class="feature-icon">🚀</span>
                        <h3>Fast</h3>
                        <p>Lightning fast performance</p>
                    </div>
                    <div class="feature-card">
                        <span class="feature-icon">💫</span>
                        <h3>Modern</h3>
                        <p>Built with latest technology</p>
                    </div>
                    <div class="feature-card">
                        <span class="feature-icon">🔒</span>
                        <h3>Secure</h3>
                        <p>Enterprise-grade security</p>
                    </div>
                </div>
            </section>
        </main>
        
        <footer>
            <p>Created with CrackerBot 🤖</p>
        </footer>
    </div>
    <script src="app.js"></script>
</body>
</html>`;
        
        return htmlContent;
    }
    
    generateCSS() {
        return `* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Courier New', monospace;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
}

.cosmic-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(white 1px, transparent 1px);
    background-size: 50px 50px;
    opacity: 0.05;
    pointer-events: none;
    animation: drift 20s linear infinite;
}

@keyframes drift {
    from { transform: translate(0, 0); }
    to { transform: translate(50px, 50px); }
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
}

h1 {
    font-size: 2.5rem;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
    animation: glow 2s ease-in-out infinite alternate;
}

@keyframes glow {
    from { text-shadow: 0 0 20px rgba(255, 255, 255, 0.5); }
    to { text-shadow: 0 0 30px rgba(255, 255, 255, 0.8); }
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    padding: 10px 20px;
    border: 2px solid transparent;
    border-radius: 25px;
    transition: all 0.3s;
}

nav a:hover {
    border-color: white;
    background: rgba(255, 255, 255, 0.1);
}

#hero {
    text-align: center;
    padding: 80px 20px;
}

#hero h2 {
    font-size: 3rem;
    margin-bottom: 20px;
}

.description {
    font-size: 1.2rem;
    margin-bottom: 40px;
    opacity: 0.9;
}

.cta-button {
    background: linear-gradient(135deg, #00ff88, #00ccff);
    color: black;
    border: none;
    padding: 15px 40px;
    font-size: 18px;
    font-weight: bold;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(0, 255, 136, 0.4);
}

.cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 25px rgba(0, 255, 136, 0.6);
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-top: 40px;
}

.feature-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 30px;
    border-radius: 20px;
    text-align: center;
    transition: all 0.3s;
}

.feature-card:hover {
    transform: translateY(-10px);
    background: rgba(255, 255, 255, 0.15);
}

.feature-icon {
    font-size: 48px;
    display: block;
    margin-bottom: 20px;
}

footer {
    text-align: center;
    padding: 40px 20px;
    margin-top: 80px;
}

@media (max-width: 768px) {
    .feature-grid {
        grid-template-columns: 1fr;
    }
    
    h1 {
        font-size: 1.8rem;
    }
}`;
    }
    
    generateJS() {
        const projectName = this.projectData.projectName || "My Project";
        
        return `console.log("🚀 ${projectName} Loaded!");

document.addEventListener("DOMContentLoaded", () => {
    // CTA Button handler
    const ctaButton = document.querySelector(".cta-button");
    if (ctaButton) {
        ctaButton.addEventListener("click", () => {
            alert("Welcome to ${projectName}! 🌌");
        });
    }
    
    // Smooth scrolling for navigation
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener("click", function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute("href"));
            if (target) {
                target.scrollIntoView({ behavior: "smooth" });
            }
        });
    });
    
    // Add particles on mouse move
    document.addEventListener("mousemove", (e) => {
        if (Math.random() > 0.98) {
            createParticle(e.clientX, e.clientY);
        }
    });
    
    function createParticle(x, y) {
        const particle = document.createElement("div");
        particle.style.position = "fixed";
        particle.style.left = x + "px";
        particle.style.top = y + "px";
        particle.style.width = "4px";
        particle.style.height = "4px";
        particle.style.background = "white";
        particle.style.borderRadius = "50%";
        particle.style.pointerEvents = "none";
        particle.style.animation = "particleFade 1s ease forwards";
        
        document.body.appendChild(particle);
        setTimeout(() => particle.remove(), 1000);
    }
    
    // Add particle animation style
    if (!document.getElementById("particle-style")) {
        const style = document.createElement("style");
        style.id = "particle-style";
        style.textContent = \`
            @keyframes particleFade {
                from {
                    opacity: 1;
                    transform: scale(1) translateY(0);
                }
                to {
                    opacity: 0;
                    transform: scale(0) translateY(-20px);
                }
            }
        \`;
        document.head.appendChild(style);
    }
});`;
    }
    
    generateREADME() {
        return `# ${this.projectData.projectName}

## 🌌 Overview
${this.projectData.features}

## 🚀 Quick Start
1. Open index.html in your browser
2. Or use a local server: python -m http.server 8000

## 📁 Project Structure
- index.html - Main HTML file
- styles.css - Styling
- app.js - JavaScript functionality
- README.md - This file

## ✨ Features
- Modern responsive design
- Smooth animations
- Interactive elements
- Cross-browser compatible

## 🤖 Built with CrackerBot
Created using the cosmic power of CrackerBot AI!

---
Created with ❤️ by ${window.userName || 'User'}`;
    }
    
    renderFileTabs() {
        const tabsContainer = document.getElementById("file-tabs");
        if (!tabsContainer) return;
        
        tabsContainer.innerHTML = "";
        
        this.files.forEach(file => {
            const tab = document.createElement("div");
            tab.className = "file-tab";
            if (file === this.currentFile) {
                tab.classList.add("active");
            }
            
            tab.innerHTML = `
                <span class="file-icon">${file.icon}</span>
                <span class="file-name">${file.name}</span>
            `;
            
            tab.onclick = () => this.selectFile(file);
            tabsContainer.appendChild(tab);
        });
    }
    
    selectFile(file) {
        this.currentFile = file;
        this.renderFileTabs();
        
        const codeEditor = document.getElementById("code-editor");
        if (codeEditor) {
            codeEditor.value = file.content;
        }
        
        if (this.viewMode === "preview" && file.type === "html") {
            this.updatePreview();
        }
    }
    
    updatePreview() {
        const iframe = document.getElementById("preview-iframe");
        if (!iframe) return;
        
        const htmlFile = this.files.find(f => f.type === "html");
        const cssFile = this.files.find(f => f.type === "css");
        const jsFile = this.files.find(f => f.type === "javascript");
        
        if (htmlFile) {
            let fullHTML = htmlFile.content;
            
            if (cssFile) {
                fullHTML = fullHTML.replace(
                    '<link rel="stylesheet" href="styles.css">',
                    `<style>${cssFile.content}</style>`
                );
            }
            
            if (jsFile) {
                fullHTML = fullHTML.replace(
                    '<script src="app.js"></script>',
                    `<script>${jsFile.content}</script>`
                );
            }
            
            const blob = new Blob([fullHTML], { type: "text/html" });
            const url = URL.createObjectURL(blob);
            iframe.src = url;
            
            const spinner = document.querySelector(".loading-spinner");
            if (spinner) spinner.style.display = "none";
        }
    }
    
    setViewMode(mode) {
        this.viewMode = mode;
        
        const previewView = document.getElementById("preview-view");
        const codeView = document.getElementById("code-view");
        const toggleBtns = document.querySelectorAll(".toggle-btn");
        
        toggleBtns.forEach(btn => btn.classList.remove("active"));
        
        if (mode === "preview") {
            if (previewView) previewView.style.display = "block";
            if (codeView) codeView.style.display = "none";
            if (toggleBtns[0]) toggleBtns[0].classList.add("active");
            this.updatePreview();
        } else {
            if (previewView) previewView.style.display = "none";
            if (codeView) codeView.style.display = "flex";
            if (toggleBtns[1]) toggleBtns[1].classList.add("active");
        }
    }
    
    setupEventListeners() {
        const codeEditor = document.getElementById("code-editor");
        if (codeEditor) {
            codeEditor.addEventListener("input", (e) => {
                if (this.currentFile) {
                    this.currentFile.content = e.target.value;
                    
                    if (this.viewMode === "preview") {
                        clearTimeout(this.updateTimeout);
                        this.updateTimeout = setTimeout(() => {
                            this.updatePreview();
                        }, 500);
                    }
                }
            });
        }
        
        // Close on escape
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                this.close();
            }
        });
    }
    
    setupAIIntegration() {
        // Placeholder for AI integration
    }
    
    sendAIRequest() {
        const input = document.getElementById("ai-input");
        if (!input) return;
        
        const request = input.value.trim();
        if (!request) return;
        
        const status = document.getElementById("ai-status");
        if (status) {
            status.textContent = "🤔 Thinking...";
        }
        
        // Simulate AI response
        setTimeout(() => {
            this.applyAIChanges(request);
            if (status) {
                status.textContent = "✅ Applied!";
            }
            setTimeout(() => {
                if (status) status.textContent = "Ready";
            }, 2000);
        }, 1500);
        
        input.value = "";
    }
    
    applyAISuggestion(suggestion) {
        const input = document.getElementById("ai-input");
        if (input) {
            input.value = suggestion;
            this.sendAIRequest();
        }
    }
    
    applyAIChanges(request) {
        if (!this.currentFile) return;
        
        let content = this.currentFile.content;
        const requestLower = request.toLowerCase();
        
        if (this.currentFile.type === "css") {
            if (requestLower.includes("dark")) {
                content = content.replace(
                    "background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);",
                    "background: #1a1a1a;"
                );
                content = content.replace("color: white;", "color: #e0e0e0;");
            }
            
            if (requestLower.includes("animation")) {
                content += `\n\n/* AI Added Animations */
@keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
}

.cta-button {
    animation: bounce 2s infinite;
}

.feature-card {
    animation: fadeIn 0.5s ease;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}`;
            }
        }
        
        this.currentFile.content = content;
        
        const codeEditor = document.getElementById("code-editor");
        if (codeEditor) {
            codeEditor.value = content;
        }
        
        this.updatePreview();
    }
    
    async download() {
        if (typeof JSZip === 'undefined') {
            alert("Please wait for JSZip to load...");
            return;
        }
        
        const zip = new JSZip();
        
        this.files.forEach(file => {
            zip.file(file.name, file.content);
        });
        
        const content = await zip.generateAsync({ type: "blob" });
        const url = URL.createObjectURL(content);
        const a = document.createElement("a");
        a.href = url;
        a.download = (this.projectData.projectName || "project").toLowerCase().replace(/\s+/g, "-") + ".zip";
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        
        if (window.addMessage) {
            window.addMessage("System", "📥 Downloaded project files!", "system");
        }
    }
    
    refine() {
        this.close();
        if (window.handleOption) {
            window.handleOption("Refine Project");
        }
    }
    
    close() {
        const modal = document.getElementById("preview-popup");
        if (modal) {
            modal.remove();
        }
        window.previewPopup = null;
    }
}

// Export
window.PreviewPopup = PreviewPopup;
window.showPreviewPopup = function(projectData, socket) {
    // Load CSS if not loaded
    if (!document.getElementById("preview-popup-css")) {
        const link = document.createElement("link");
        link.id = "preview-popup-css";
        link.rel = "stylesheet";
        link.href = "/crackerbot-preview.css";
        document.head.appendChild(link);
    }
    
    // Load JSZip if not loaded
    if (typeof JSZip === "undefined") {
        const script = document.createElement("script");
        script.src = "https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js";
        script.onload = () => {
            new PreviewPopup(projectData, socket || null);
        };
        document.body.appendChild(script);
    } else {
        new PreviewPopup(projectData, socket || null);
    }
};
