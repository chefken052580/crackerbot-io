// Working Preview AI Updates

(function() {
    // Initialize preview AI when popup opens
    window.initializePreviewAI = function() {
        console.log("Initializing preview AI system...");
        
        const aiInput = document.getElementById('ai-input');
        const aiButton = document.querySelector('.ai-apply-btn');
        
        if (aiInput) {
            // Handle Enter key
            aiInput.addEventListener('keydown', async (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    await handleAIRequest(aiInput.value);
                    aiInput.value = '';
                }
            });
        }
        
        if (aiButton) {
            aiButton.addEventListener('click', async () => {
                if (aiInput && aiInput.value) {
                    await handleAIRequest(aiInput.value);
                    aiInput.value = '';
                }
            });
        }
    };
    
    // Handle AI request
    async function handleAIRequest(request) {
        if (!request.trim()) return;
        
        console.log("Processing AI request:", request);
        
        const editor = document.getElementById('code-editor');
        const preview = document.getElementById('preview-frame');
        const status = document.getElementById('ai-status');
        
        if (!editor) {
            console.error("Code editor not found");
            return;
        }
        
        // Update status
        if (status) {
            status.textContent = "🤔 Updating code...";
            status.style.color = "#ffcc00";
        }
        
        try {
            // Get current file info
            const currentFile = window.currentPreviewFile || { name: 'index.html', type: 'html' };
            const currentCode = editor.value;
            
            // Determine file type
            let fileType = 'html';
            if (currentFile.name.endsWith('.css')) fileType = 'css';
            else if (currentFile.name.endsWith('.js')) fileType = 'javascript';
            else if (currentFile.name.endsWith('.py')) fileType = 'python';
            else if (currentFile.name.endsWith('.sol')) fileType = 'solidity';
            
            // Send to backend
            const response = await fetch('https://crackerbot.io/api/ai-update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    currentCode: currentCode,
                    fileType: fileType,
                    request: request
                })
            });
            
            if (!response.ok) {
                throw new Error('AI update failed');
            }
            
            const data = await response.json();
            const newCode = data.code;
            
            // Update editor
            editor.value = newCode;
            
            // Update file in memory
            if (window.currentTask && window.currentTask.files) {
                window.currentTask.files[currentFile.name] = newCode;
                window.currentPreviewFile.content = newCode;
            }
            
            // Update preview
            updateLivePreview();
            
            // Success status
            if (status) {
                status.textContent = "✅ Updated!";
                status.style.color = "#00ff85";
                setTimeout(() => {
                    status.textContent = "Ready";
                    status.style.color = "";
                }, 2000);
            }
            
        } catch (error) {
            console.error("AI update error:", error);
            
            // Fallback updates
            applyFallbackChanges(request);
        }
    }
    
    // Update live preview
    function updateLivePreview() {
        const preview = document.getElementById('preview-frame');
        if (!preview || !window.currentTask) return;
        
        const files = window.currentTask.files || {};
        
        // Get all files
        let html = files['index.html'] || '';
        const css = files['styles.css'] || files['style.css'] || '';
        const js = files['app.js'] || files['game.js'] || files['script.js'] || '';
        
        // Embed CSS and JS into HTML
        if (css && !html.includes('<style>')) {
            html = html.replace('</head>', `<style>${css}</style>\n</head>`);
        }
        
        if (js && !html.includes('<script>')) {
            html = html.replace('</body>', `<script>${js}</script>\n</body>`);
        }
        
        // Update preview
        preview.srcdoc = html;
        
        console.log("Preview updated");
    }
    
    // Fallback changes when API fails
    function applyFallbackChanges(request) {
        const editor = document.getElementById('code-editor');
        if (!editor) return;
        
        let code = editor.value;
        const req = request.toLowerCase();
        
        // Apply basic changes
        if (req.includes('dark')) {
            if (code.includes('<body')) {
                code = code.replace('<body', '<body style="background:#1a1a1a;color:white;"');
            } else if (code.includes('body {')) {
                code = code.replace('body {', 'body { background: #1a1a1a; color: white;');
            }
        }
        
        if (req.includes('title')) {
            const newTitle = request.match(/title\s+to\s+["']?([^"']+)["']?/i)?.[1] || 'New Title';
            code = code.replace(/<title>.*?<\/title>/, `<title>${newTitle}</title>`);
            code = code.replace(/<h1>.*?<\/h1>/, `<h1>${newTitle}</h1>`);
        }
        
        editor.value = code;
        updateLivePreview();
        
        const status = document.getElementById('ai-status');
        if (status) {
            status.textContent = "✅ Applied (fallback)";
            setTimeout(() => { status.textContent = "Ready"; }, 2000);
        }
    }
    
    // Initialize when preview opens
    document.addEventListener('click', (e) => {
        if (e.target.textContent?.includes('Preview') || 
            e.target.classList.contains('preview-btn') ||
            e.target.classList.contains('inline-preview-btn')) {
            setTimeout(initializePreviewAI, 500);
        }
    });
    
    // Also initialize on page load
    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(initializePreviewAI, 1000);
    });
    
    // Make updateLivePreview globally available
    window.updateLivePreview = updateLivePreview;
})();

console.log("✅ Working preview AI loaded");
